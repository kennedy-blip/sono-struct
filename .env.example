# Optional cloud sync. Leave blank to run fully local (the default).
# The app degrades gracefully: no keys ⇒ queue stays in IndexedDB and the
# vault reports "LOCAL ONLY" instead of "CLOUD SYNCED".
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key
